[Unit]
Description=Keyboard debouncer for %f

[Service]
Environment=RIPPLES_ARGS=
EnvironmentFile=-/etc/ripples.conf
ExecStart=/usr/bin/ripples --wait-for-device $RIPPLES_ARGS %f

Restart=always
RestartSec=1

DynamicUser=yes
SupplementaryGroups=input ripples-uinput

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
IPAddressDeny=any
PrivateNetwork=yes
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
